	(text "Vin: 12 V nominal \nVout: 5 V @ 2 A target\nDC ≈ 0.42\n\n"
		(exclude_from_sim no)
		(at 37.338 51.562 0)
		(effects
			(font
				(face "Arial Black")
				(size 1.905 1.905)
			)
		)
		(uuid "7db8566a-0dd7-4645-b050-e9e4f11c91af")
	)
	(text "1) Key Design Points \n \n- L1 = 10 µH, ripple ≈ 0.6 A (30% of 2 A)\n- COUT ≈ 44 µF ceramic (2 × 22 µF) + optional 47 µF electrolytic\n- CIN: 10 µF ceramic + 47 µF electrolytic near VIN\n- FB divider: Rtop ≈ 425 kΩ, Rbot = 100 kΩ → Vout ≈ 5 V\n- RT ≈ 100 kΩ → fSW ≈ 500 kHz (check datasheet table)\n- BST cap: 0.1 µF (BST–SW)\n- INTVcc cap: 4.7 µF (INTVcc–GND)\n- Soft-start cap: 10 nF (TR/SS–GND)\n \n2) Simulation\n \n- .transient, time limit of 100ms\n- Probe Vout, IL, Vsw, PG"
		(exclude_from_sim no)
		(at 189.484 83.312 0)
		(effects
			(font
				(face "Arial Black")
				(size 1.905 1.905)
			)
			(justify left top)
		)
		(uuid "af1349ea-b282-40b3-ba87-d3b31933763b")
	)
